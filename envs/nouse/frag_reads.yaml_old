name: frag_reads
channels:
  - conda-forge
  - bioconda
channel_priority: strict
show_channel_urls: true
denylist_channels:
  - https://repo.anaconda.com/pkgs/main
  - https://repo.anaconda.com/pkgs/r
dependencies:
  - python=3.10
  - snakemake-minimal
  - pandas
  - numpy
  - pyyaml
  - bwa=0.7.18
  - samtools=1.23
  - fastp=1.3.1
  - fastqc=0.12.1
  - multiqc
  - picard=3.4.0
  - openjdk=17
  - deeptools=3.5.6
  - r-base=4.3.2
  - r-tidyverse
  - r-stringr
  - r-optparse
